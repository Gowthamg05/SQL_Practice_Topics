use salesdb

-- using cte functions
-- find the total  sales per customer
-- also find the last order date of customers
-- also give the rank to the customers 
-- for here we want to use another cte 

with total_sales as
			(select 
				customerid,
	
				sum(sales) as tot_sales
				from sales.orders
				group by customerid)
-- step 2:  find the last date of order to the customer 
,last_date as 
			(
				select 
					customerid,
					max(orderdate) as last_orders
					from sales.orders
					group by customerid )
-- step 3: rank the customer based on the sales
,rank_customers as
			(select 
				customerid,
				tot_sales,
				rank()over(order by tot_sales desc) as ranking_customer
				from total_sales
				)
-- step:4 segment customer based on thier total sales
,cte_segment as 
(	
	select 
	customerid,
	case when tot_sales > 100 then 'high'
		when tot_sales> 50 then 'medium'
		else 'low'
		end over_segment
		from total_sales
		)


select 
c.customerid,
c.firstname,
c.lastname,
cts.tot_sales,
ld.last_orders,
rc.ranking_customer,
cs.over_segment
from sales.customers c
left join total_sales cts
on c.customerid=cts.customerid
left join last_date ld
on c.customerid=ld.customerid
left join rank_customers rc
on c.customerid=rc.customerid
left join cte_segment cs
on c.customerid=cs.customerid


use salesdb

/* Show each customer’s full name, country, total number of orders, and total sales from the Orders table. 
Include customers with no orders (show 0 instead of NULL). Sort by total sales, highest first.*/
with c_name as(
	select 
	customerid,
	firstname,
	lastname,
	country
	from sales.customers
	),
 m_table as(
	select 
		customerid,
		count(orderid)as tot_orders,
		sum(sales)as tot_sales
		from sales.orders 
		group by customerid
		)

select 
c.firstname,c.lastname,c.country,
c.firstname+' '+c.lastname as Full_name,
COALESCE(t.tot_orders, 0) AS tot_orders,
COALESCE(t.tot_sales, 0)  AS tot_sales
from c_name c
left join  m_table t
on t.customerid=c.customerid
order by t.tot_sales desc

/* NULL handling + CASE
For the Orders table, create a column AddressStatus that says:

'Missing Both' if ShipAddress and BillAddress are both NULL
'Missing Bill' if only BillAddress is NULL
'Complete' otherwise */

select * from sales.orders

SELECT
    OrderID,
    ShipAddress,
    BillAddress,
    CASE
        WHEN ShipAddress IS NULL AND BillAddress IS NULL THEN 'Missing Both'
        WHEN BillAddress IS NULL THEN 'Missing Bill'
        ELSE 'Complete'
    END AS AddressStatus
FROM Sales.Orders;
/* (Advanced): Self Join
Show each employee’s name along with their manager’s full name. 
Employees with no manager should show 'No Manager'. 
Handle the NULL LastName for Mary carefully so the full name doesn’t become NULL.*/

select * from sales.employees

select 
	e.firstname,
	e1.firstname
	from sales.employees e
	join sales.employees e1
	on e1.managerid=e.employeeid

SELECT
    e.firstname AS employee_name,
    COALESCE(m.firstname + ' ' + m.lastname, m.firstname, 'No Manager') AS manager_name
FROM sales.employees e
LEFT JOIN sales.employees m
    ON e.managerid = m.employeeid;

/* (Advanced): Window Functions
For each salesperson in the Orders table, show:
Their orders ranked by Sales (highest first) using ROW_NUMBER()
A running total of Sales ordered by OrderDate
The difference between each order’s Sales and the previous order’s 
Sales for that salesperson (use LAG())*/

select * from sales.orders



	SELECT
    salespersonid,
    orderid,
    orderdate,
    sales,
    ROW_NUMBER() OVER (
        PARTITION BY salespersonid
        ORDER BY sales DESC
    ) AS sales_rank,
    SUM(sales) OVER (
        PARTITION BY salespersonid
        ORDER BY orderdate, orderid
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS running_total,
    LAG(sales) OVER (
        PARTITION BY salespersonid
        ORDER BY orderdate, orderid
    ) AS previous_sales,
    sales - LAG(sales) OVER (
        PARTITION BY salespersonid
        ORDER BY orderdate, orderid
    ) AS sales_diff
FROM sales.orders
ORDER BY salespersonid, orderdate, orderid;

/* (Advanced): CTE + Deduplication + Subquery
In OrdersArchive, some OrderIDs appear twice (for example OrderID 4 and 6) with different 
statuses or creation times.
Write a query that keeps only the latest record per OrderID (based on CreationTime). 
Then, using that cleaned result, find the total sales per product Category by joining to Products, 
and return only categories where total sales is above the average category total. */

select * from sales.OrdersArchive

    


WITH dedup AS (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY orderid
               ORDER BY creationtime DESC
           ) AS rn
    FROM sales.ordersarchive
),
latest_orders AS (
    SELECT *
    FROM dedup
    WHERE rn = 1
),
category_totals AS (
    SELECT
        p.category,
        SUM(o.sales) AS total_sales
    FROM latest_orders o
    JOIN sales.products p
        ON p.productid = o.productid
    GROUP BY p.category
)
SELECT
    category,
    total_sales
FROM category_totals
WHERE total_sales > (SELECT AVG(total_sales) FROM category_totals)
ORDER BY total_sales DESC;
