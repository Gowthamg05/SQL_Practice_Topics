                    avg(score) as avg_score 
                    from sales.customers
                    where country='usa')

/* Q17 — Correlated
Find products whose price is equal to the maximum price in their own category.
Display: ProductID, Product, Category, Price. */

select 
        p1.productid,
        p1.product,
        p1.category,
        p1.price
        from sales.products p1
        where price =
                    (select 
                    max(price) as max_price 
                    from sales.products p
                    where p.category=p1.category)

/* Q18 — Correlated
Find customers who have placed an order with a Sales value greater than the average Sales of orders
placed by that same customer.
Display: CustomerID, FirstName */
SELECT DISTINCT
    o.customerid,
    (
        SELECT c.firstname
        FROM sales.customers c
        WHERE c.customerid = o.customerid
    ) AS firstname
FROM sales.orders o
WHERE o.sales >
(
    SELECT AVG(o2.sales)
    FROM sales.orders o2
    WHERE o2.customerid = o.customerid
);
