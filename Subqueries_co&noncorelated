use salesdb

/* Q13 — Correlated
Find customers who have placed more orders than the average number of orders placed by customers.
Display: CustomerID, FirstName, TotalOrders. Requires aggregation inside a subquery */



SELECT
    o.customerid,
    c.firstname,
    COUNT(*) AS TotalOrders
FROM sales.orders o
JOIN sales.customers c
    ON o.customerid = c.customerid
GROUP BY
    o.customerid,
    c.firstname
HAVING COUNT(*) >
(
    SELECT AVG(TotalOrders)
    FROM
    (
        SELECT
            customerid,
            COUNT(*) AS TotalOrders
        FROM sales.orders
        GROUP BY customerid
    ) t
);


/* Q14 — Correlated
Find employees whose salary is greater than the average salary of employees reporting to the same
manager.
Display: EmployeeID, FirstName, ManagerID, Salary. */

select * from sales.employees

select 
    e1.employeeid,
    e1.firstname,
    e1.managerid,
    e1.salary
    from sales.employees e1
    where e1.salary >
               ( select 
                avg(salary)as avg_salary 
                from sales.employees e
                where e.managerid=e1.managerid
                    ) 
/* Q15 — Non-correlated
Find all orders whose Sales are greater than the maximum Sales value in sales.ordersarchive.
Display: OrderID, CustomerID, Sales. */

select * from sales.OrdersArchive

select 
    orderid,
    customerid,
    sales
    from sales.OrdersArchive
    where sales > =
                ( select max(sales) as max_sales from sales.OrdersArchive)
                 group by orderid,customerid,sales

/* Q16 — Non-correlated
Find customers whose Score is greater than the average Score of customers who are from the USA.
Display: CustomerID, FirstName, Country, Score. */

