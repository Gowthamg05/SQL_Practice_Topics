/* Q7 — Non-correlated
Find customers who have placed at least one order. Use a subquery.
Display: CustomerID, FirstName. The subquery should obtain relevant CustomerIDs from sales.orders */


select customerid,
firstname
from sales.customers
where customerid  in (
select 
customerid
from sales.orders
group by customerid
having count(*)>=1)

/* Q8 — Non-correlated
Find products that have never been ordered. Use a subquery.
Display: ProductID, Product. Think carefully about NOT IN and NULL */

select * from sales.orders

select productid,
product from sales.products
where productid not in (
select 
productid
from sales.orders
where productid is not null
group by productid)

/* Q9 — Non-correlated
Find employees whose salary is greater than the maximum salary of employees in the Marketing
department.
Display: EmployeeID, FirstName, Department, Salary */


select * from sales.employees
where salary > ( select max(salary) from sales.employees
				where department ='marketing')

